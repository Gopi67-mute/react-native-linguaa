# Placeholder names only -- do not put real values in this file.
#
# agent.py loads the actual values from the repo root .env (one directory
# up), which already has STREAM_API_KEY and STREAM_API_SECRET for the Expo
# app. Add OPENAI_API_KEY to that same root .env; this file just documents
# what's required.
STREAM_API_KEY=
STREAM_API_SECRET=
OPENAI_API_KEY=

# Shared secret this service checks on every /calls/*/sessions request (see
# agent.py's _require_service_secret). Must match the value the Expo backend
# sends via lib/vision-agent-client.ts -- same root .env, both sides read
# VISION_AGENT_SERVICE_SECRET.
VISION_AGENT_SERVICE_SECRET=
